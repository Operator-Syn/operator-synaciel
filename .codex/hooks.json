{
  "description": "Repository-local Graphify, documentation, and guarded commit workflow.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'root=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; exec bash \"$root/.codex/hooks/repository-session-start.sh\"'",
            "statusMessage": "Loading repository workflow",
            "timeout": 5,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'root=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; exec bash \"$root/.codex/hooks/repository-session-start.sh\"'",
            "statusMessage": "Loading repository workflow",
            "timeout": 5,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'root=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; cd \"$root\"; exec pipenv run graphify hook-check'",
            "statusMessage": "Checking Graphify workflow"
          },
          {
            "type": "command",
            "command": "bash -lc 'root=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; exec node \"$root/.codex/hooks/repository-commit-gate.mjs\"'",
            "statusMessage": "Checking repository commit workflow",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'root=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; cd \"$root\"; exec node scripts/check-docs.mjs --hook'",
            "timeout": 5,
            "statusMessage": "Checking documentation"
          }
        ]
      },
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'root=\"$(git rev-parse --show-toplevel 2>/dev/null || exit 1)\"; cd \"$root\"; exec node \"$root/.agents/skills/impeccable/scripts/hook.mjs\"'",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'root=\"$(git rev-parse --show-toplevel 2>/dev/null || exit 1)\"; cd \"$root\"; exec node \"$root/.agents/skills/impeccable/scripts/hook.mjs\"'",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  }
}
