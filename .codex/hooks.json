{
  "description": "Repository-local documentation and guarded commit workflow.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'root=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; exec bash \"$root/.codex/hooks/repository-session-start.sh\"'",
            "statusMessage": "Loading repository workflow",
            "timeout": 5,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'root=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; exec bash \"$root/.codex/hooks/repository-session-start.sh\"'",
            "statusMessage": "Loading repository workflow",
            "timeout": 5,
            "additionalContextLimit": 1200
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'root=\"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"; cd \"$root\"; exec node scripts/check-docs.mjs --hook'",
            "timeout": 5,
            "statusMessage": "Checking documentation"
          }
        ]
      },
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'root=\"$(git rev-parse --show-toplevel 2>/dev/null || exit 1)\"; cd \"$root\"; exec node \"$root/scripts/check-biome-hook.mjs\"'",
            "timeout": 120,
            "statusMessage": "Checking Biome after repository changes"
          }
        ]
      },
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'root=\"$(git rev-parse --show-toplevel 2>/dev/null || exit 1)\"; cd \"$root\"; exec node \"$root/scripts/impeccable-hook.mjs\"'",
            "commandWindows": "powershell -NoProfile -Command \"$root = git rev-parse --show-toplevel; if ($LASTEXITCODE -eq 0) { & node (Join-Path $root 'scripts/impeccable-hook.mjs') }\"",
            "timeout": 20,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -lc 'root=\"$(git rev-parse --show-toplevel 2>/dev/null || exit 1)\"; cd \"$root\"; exec node \"$root/scripts/impeccable-hook.mjs\"'",
            "commandWindows": "powershell -NoProfile -Command \"$root = git rev-parse --show-toplevel; if ($LASTEXITCODE -eq 0) { & node (Join-Path $root 'scripts/impeccable-hook.mjs') }\"",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  }
}
