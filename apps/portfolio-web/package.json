{
  "name": "@syn-forge/portfolio-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --pretty false --noEmit && vite build",
    "preview": "npm run build && serve -s dist",
    "pages:dev": "wrangler pages dev dist",
    "generate:social-previews": "tsx --tsconfig tsconfig.node.json scripts/generate-social-previews.ts",
    "test": "tsx --tsconfig ../../tsconfig.tests.json --test ../../tests/portfolio-web/*.test.ts ../../tests/portfolio-web/*.test.tsx",
    "test:social-preview": "tsx --tsconfig ../../tsconfig.tests.json --test ../../tests/portfolio-web/social-preview.test.ts",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "typecheck": "tsc -b --pretty false --noEmit"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.87",
    "@cloudflare/ai-chat": "^0.11.0",
    "@tanstack/react-query": "^5.90.12",
    "agents": "0.22.0",
    "lucide-react": "^1.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.8.1",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260820.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.2.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.6.0",
    "playwright": "^1.62.1",
    "serve": "^14.2.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vite-plugin-sitemap": "^0.8.2",
    "wrangler": "4.125.0"
  }
}
