# Vite reads the repository root .env file through apps/portfolio-web/vite.config.ts.
# Use the deployed Workers from a local Vite session. The Workers' parameterized
# BROWSER_ORIGINS list must include http://localhost:<port>.
VITE_PUBLIC_AUTH_URL=https://public-auth.syn-forge.com

# Use a local Turnstile widget site key. Leave empty only when testing the
# assistant's unconfigured-state UI.
VITE_TURNSTILE_SITE_KEY=
