{
  "homepage": "https://operator-eury.github.io/",
  "name": "vite-project-by-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -b gh-pages -d dist",
    "dev": "vite",
    "docs:check": "node scripts/check-docs.mjs",
    "db:migration:create": "wrangler d1 migrations create my-personal-portfolio",
    "db:migrations:list:local": "wrangler d1 migrations list my-personal-portfolio --local",
    "db:migrations:list:remote": "wrangler d1 migrations list my-personal-portfolio --remote",
    "db:migrations:apply:local": "wrangler d1 migrations apply my-personal-portfolio --local",
    "db:migrations:apply:remote": "wrangler d1 migrations apply my-personal-portfolio --remote",
    "mcp:context": "tsx mcp/server.ts",
    "mcp:typecheck": "tsc -p tsconfig.mcp.json --noEmit",
    "test:mcp": "tsx --test tests/mcp/*.test.ts tests/scripts/*.test.ts",
    "setup:git-hooks": "tsx scripts/setup-git-hooks.ts",
    "validate:commit": "tsx scripts/validate-commit.ts",
    "check:one-file-history": "tsx scripts/audit-one-file-history.ts --range origin/main..HEAD",
    "typecheck": "tsc -b --pretty false",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "npm run build && serve -s dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@tanstack/react-query": "^5.90.12",
    "@vercel/og": "^0.11.1",
    "bootstrap": "^5.3.8",
    "gh-pages": "^6.3.0",
    "hono": "^4.11.1",
    "lucide-react": "^1.17.0",
    "react": "^19.1.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.8.1",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "shx": "^0.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251217.0",
    "@eslint/js": "^9.30.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/bootstrap": "^5.2.10",
    "@types/node": "^25.2.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "serve": "^14.2.5",
    "tsx": "^4.23.12",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vite-plugin-sitemap": "^0.8.2",
    "wrangler": "^4.67.0",
    "zod": "^4.4.3"
  }
}
