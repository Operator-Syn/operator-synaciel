{
  "homepage": "https://operator-eury.github.io/",
  "name": "vite-project-by-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -b gh-pages -d dist",
    "dev": "vite",
    "pages:dev": "wrangler pages dev dist",
    "generate:social-previews": "tsx --tsconfig tsconfig.node.json scripts/generate-social-previews.ts",
    "docs:check": "node scripts/check-docs.mjs",
    "db:migration:generate": "drizzle-kit generate",
    "db:migration:custom": "drizzle-kit generate --custom",
    "db:migration:check": "drizzle-kit check",
    "db:migrations:list:local": "wrangler d1 migrations list my-personal-portfolio --local",
    "db:migrations:list:remote": "wrangler d1 migrations list my-personal-portfolio --remote",
    "db:migrations:apply:local": "wrangler d1 migrations apply my-personal-portfolio --local",
    "db:migrations:apply:remote": "wrangler d1 migrations apply my-personal-portfolio --remote",
    "mcp:check": "node scripts/check-mcp-config.mjs",
    "mcp:repository": "node scripts/mcp-launcher.mjs repository",
    "mcp:graphify": "node scripts/mcp-launcher.mjs graphify",
    "mcp:context": "npm run mcp:repository",
    "mcp:portfolio:check": "tsc -p tsconfig.portfolio-mcp.json --pretty false --noEmit",
    "mcp:portfolio:dev": "wrangler dev --config workers/portfolio-mcp/wrangler.toml --env local",
    "mcp:portfolio:deploy": "wrangler deploy --config workers/portfolio-mcp/wrangler.toml --env=\"\"",
    "skills:check": "node scripts/validate-skills.mjs",
    "mcp:typecheck": "tsc -p tsconfig.mcp.json --noEmit",
    "test:mcp": "tsx --test tests/mcp/*.test.ts tests/scripts/*.test.ts",
    "test:media-presign": "tsx --test tests/media-presign.test.ts",
    "test:project-pagination": "tsx --test tests/project-pagination.test.ts",
    "test:social-preview": "tsx --test tests/social-preview.test.ts",
    "test:portfolio-mcp": "tsx --test tests/portfolio-mcp.test.ts",
    "setup:git-hooks": "tsx scripts/setup-git-hooks.ts",
    "validate:commit": "tsx scripts/validate-commit.ts",
    "check:one-file-history": "tsx scripts/audit-one-file-history.ts --range origin/main..HEAD",
    "format:biome": "biome format --write .",
    "format:biome:check": "biome format . --max-diagnostics=none",
    "lint:biome": "biome lint . --max-diagnostics=none",
    "check:biome": "biome check . --max-diagnostics=none",
    "check:biome:github": "biome check . --max-diagnostics=none --reporter=github",
    "typecheck": "tsc -b --pretty false --noEmit",
    "typecheck:watch": "tsc -b --watch --pretty false",
    "build": "tsc -b --pretty false --noEmit && vite build",
    "lint": "eslint .",
    "preview": "npm run build && serve -s dist"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.1000.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@tanstack/react-query": "^5.90.12",
    "agents": "0.22.0",
    "gh-pages": "^6.3.0",
    "hono": "^4.11.1",
    "lucide-react": "^1.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.8.1",
    "react-syntax-highlighter": "^16.1.0",
    "remark-gfm": "^4.0.1",
    "shx": "^0.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@cloudflare/workers-types": "5.20260820.1",
    "@eslint/js": "^9.30.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.2.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.6.0",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "playwright": "^1.62.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "serve": "^14.2.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vite-plugin-sitemap": "^0.8.2",
    "wrangler": "4.125.0",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.3": true,
    "esbuild@0.28.2": true,
    "esbuild@0.28.1": true,
    "workerd@1.20260820.1": true
  }
}
