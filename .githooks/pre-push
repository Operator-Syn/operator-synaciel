#!/usr/bin/env bash
set -euo pipefail

hook_directory="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

tsx="$hook_directory/../node_modules/.bin/tsx"
if [[ ! -x "$tsx" ]]; then
  echo "Push blocked: install npm dependencies before using the repository hooks." >&2
  exit 1
fi

seen=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  if [[ -z "${local_sha:-}" || -z "${remote_sha:-}" ]]; then
    echo "One-file push audit could not parse Git's ref update." >&2
    exit 1
  fi
  seen=1
  "$tsx" "$hook_directory/../scripts/audit-one-file-history.ts" \
    --local-sha "$local_sha" \
    --remote-sha "$remote_sha" \
    --remote-ref "$_remote_ref"
done

if [[ "$seen" -eq 0 ]]; then
  echo "One-file push audit received no ref updates." >&2
  exit 1
fi
