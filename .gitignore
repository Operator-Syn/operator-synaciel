!.dev.vars.example
bundle-analysis.html

# Local Wrangler output
.wrangler

# Keep old local virtual environments out of Git.
.venv

# Local Playwright authentication state
# Root path is retained so other clones that predate the workspace move stay
# protected.
/playwright/.auth/
/apps/portfolio-web/playwright/.auth/

# Redacted Playwright run output (never keep authenticated traces or HAR files)
# Root path is retained so other clones that predate the workspace move stay
# protected.
/playwright/.artifacts/
/apps/portfolio-web/playwright/.artifacts/
/apps/portfolio-web/test-results/
/apps/portfolio-web/playwright-report/

# Local Playwright browser downloads
/.playwright-browsers/

# Local direnv state
/.direnv/

# Obsidian settings and workspace state are local.
/.obsidian/
/docs/.obsidian/

# Impeccable per-developer state; shared config remains reviewable
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/live/

# Local SEO audit artifacts: private search analytics, backlink data,
# rendered captures, screenshots, and reports. Never commit.
/syn-forge.com-audit/

# Generated by scripts/prerender.ts during the build.
apps/portfolio-web/public/prerender/
